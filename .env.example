# ==============================================================================
# DRAG — Environment Configuration Template
# Copy this file to .env.local for local development.
# In production, set these variables in your Vercel project environment settings.
# ==============================================================================

# Database (Neon PostgreSQL connection string with pgvector enabled)
# Example: postgresql://user:password@ep-sample-pooler.region.neon.tech/drag?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/drag

# Better Auth Configuration
# BETTER_AUTH_SECRET: Generate with `openssl rand -hex 32` (minimum 32 characters)
BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Base URL of the application. In development: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional GitHub Personal Access Token
# Used as fallback for public repo ingestion to increase rate limits (5,000 req/hr)
# GITHUB_TOKEN=ghp_your_optional_token

# Vercel Cron Secret (Required in production)
# Automatically populated by Vercel when configured, or set manually for cron route security
CRON_SECRET=your_production_cron_secret

# NVIDIA NIM API Configuration
# NVIDIA_API_KEY is required when using the hosted NVIDIA NIM API (https://integrate.api.nvidia.com)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key

# Embedding Dimensions
# Fixed at 768 - matches PostgreSQL vector(768) and the HNSW index. Not configurable.
EMBEDDING_DIMENSIONS=768

# Google Gemini API Configuration (Public repository embeddings)
# Uses gemini-embedding-2 (768 dimensions)
GEMINI_API_KEY=your_gemini_api_key

# Cloudflare Workers AI Configuration (Private repository embeddings)
# Uses @cf/qwen/qwen3-embedding-0.6b (768 dimensions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Hobby Plan monthly RAG query limit. Defaults to 250 when unset (never unmetered).
# HOBBY_MONTHLY_QUERY_LIMIT=100

# LLM Text Generation Configuration
LLM_MODEL=minimaxai/minimax-m3
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

