{
  "name": "drag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ox": "oxlint src",
    "lint:ox:fix": "oxlint src --fix",
    "format:ox": "oxfmt --check src drizzle.config.ts next.config.ts vitest.config.ts",
    "format:ox:write": "oxfmt --write src drizzle.config.ts next.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate-schema": "npx @better-auth/cli generate --config src/lib/auth/server.ts --output src/db/schemas/auth.ts --yes",
    "eval:retrieval": "tsx src/lib/retrieval/eval/runEval.ts",
    "eval:e2e": "tsx src/lib/retrieval/eval/runE2eEval.ts",
    "eval:load": "tsx src/lib/retrieval/eval/runLoadTest.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/tar": "^6.1.13",
    "better-auth": "^1.6.23",
    "dompurify": "^3.2.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.16.1",
    "next": "16.2.10",
    "openai": "^7.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.21",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "workflow": "^4.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.14.5",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
